// Gece — compact greeting: who/what/where + one tip per terminal
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "source": "fedora",
    "color": { "1": "#7aa8ff", "2": "#d8e0ea" },
    "padding": { "top": 2, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "#7aa8ff", "title": "#a9c6ff", "output": "#d8e0ea" },
    "key": { "width": 0 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "custom", "format": "\u001b[38;2;38;49;66m──────────────────────────────" },
    { "type": "os",      "key": " ", "format": "{name} {version-id}" },
    { "type": "kernel",  "key": " ", "format": "{release}" },
    { "type": "wm",      "key": " ", "format": "Plasma · {pretty-name}" },
    { "type": "cpu",     "key": " ", "format": "{name}" },
    { "type": "gpu",     "key": "󰢮 ", "format": "{name}" },
    { "type": "memory",  "key": "󰍛 " },
    { "type": "uptime",  "key": "󰅐 " },
    { "type": "command", "key": " ", "text": "ls -t ~/Projects 2>/dev/null | head -3 | paste -sd '·' | sed 's/·/ · /g'" },
    "break",
    { "type": "command", "key": "\u001b[38;2;232;201;111m ", "text": "shuf -n1 ~/.config/zsh/tips.txt 2>/dev/null" },
    { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
  ]
}
